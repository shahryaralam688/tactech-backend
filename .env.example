APP_NAME=TacTech
APP_ENV=development
LOG_LEVEL=INFO

POSTGRES_USER=tactech
POSTGRES_PASSWORD=change_me
POSTGRES_DB=tactech

DATABASE_URL=postgresql+psycopg2://tactech:change_me@localhost:5432/tactech
REDIS_URL=redis://localhost:6379/0

JWT_SECRET=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

CORS_ORIGINS=http://localhost,http://127.0.0.1,http://localhost:8080

SEED_TRAINER_PASSWORD=trainer123
SEED_TRAINEE_PASSWORD=trainee123

PUBLIC_BASE_URL=
UPLOAD_DIR=uploads
MAX_UPLOAD_BYTES=5242880
# Avatar CDN / object storage (optional — local disk + PUBLIC_BASE_URL used when empty)
MEDIA_S3_BUCKET=
MEDIA_S3_REGION=auto
MEDIA_S3_ENDPOINT_URL=
MEDIA_S3_ACCESS_KEY_ID=
MEDIA_S3_SECRET_ACCESS_KEY=
MEDIA_CDN_BASE_URL=
MEDIA_S3_PREFIX=avatars
DEFAULT_AVATAR_ASSET=Avatar_01_Color

NGROK_AUTHTOKEN=

# AI Coach — free by default
# AI_PROVIDER=auto → HF_TOKEN if set, else GROQ_API_KEY, else local mock (no key)
# Free HF token: https://huggingface.co/settings/tokens
# Free Groq key:  https://console.groq.com/keys
AI_PROVIDER=auto
HF_TOKEN=
HF_CHAT_MODEL=meta-llama/Llama-3.1-8B-Instruct
HF_VISION_MODEL=google/gemma-3-4b-it
GROQ_API_KEY=
GROQ_CHAT_MODEL=openai/gpt-oss-20b
GROQ_STT_MODEL=whisper-large-v3
GROQ_VISION_MODEL=openai/gpt-oss-20b
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_STT_MODEL=whisper-1
OPENAI_TTS_MODEL=tts-1
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_VISION_MODEL=gpt-4o-mini
AI_TTS_PROVIDER=edge
AI_TTS_VOICE=en-US-JennyNeural
AI_MAX_CONTEXT_CHUNKS=8
AI_CHAT_TEMPERATURE=0.65
AI_CHAT_MAX_TOKENS=450
AI_EMBEDDING_DIMENSIONS=1536
WEBRTC_STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302
# Optional TURN (short-lived credentials recommended in production)
WEBRTC_TURN_URLS=
WEBRTC_TURN_USERNAME=
WEBRTC_TURN_CREDENTIAL=

# Rate limits (per user)
COACH_CHAT_RATE_LIMIT=30
COACH_IMAGE_RATE_LIMIT=10
COACH_VOICE_RATE_LIMIT=20
COACH_RTC_RATE_LIMIT=10
COACH_RATE_WINDOW_SECONDS=60
CHAT_RATE_LIMIT=60
CHAT_MEDIA_RATE_LIMIT=20
CHAT_RTC_RATE_LIMIT=10
CHAT_RATE_WINDOW_SECONDS=60
CHAT_MESSAGE_MAX_CHARS=4000
CHAT_UPLOAD_MAX_BYTES=8388608
CHAT_IMAGE_MAX_BYTES=8388608
CHAT_VIDEO_MAX_BYTES=52428800
CHAT_VOICE_MAX_BYTES=5242880
CHAT_FILE_MAX_BYTES=15728640
CHAT_RTC_IDLE_SECONDS=90
CHAT_RTC_MAX_SECONDS=3600

# Phase 2 — Trainer Boost (Stripe Checkout, test mode for staging)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=
STRIPE_SUCCESS_URL=tactech://billing/boost/success?session_id={CHECKOUT_SESSION_ID}
STRIPE_CANCEL_URL=tactech://billing/boost/cancel
# Optional: seed maps these onto billing_products.stripe_price_id
STRIPE_PRICE_BOOST_7D=
STRIPE_PRICE_BOOST_30D=

# Phase 3 — Trainee AI (Apple IAP)
APPLE_BUNDLE_ID=
APPLE_ISSUER_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY_P8=
APPLE_ENVIRONMENT=Sandbox
# 0 = hard paywall; 3 = weekly free tease messages
AI_FREE_TEASE_MESSAGES_PER_WEEK=0
AI_PRODUCT_HINT=ai.pro.monthly

# AI Gateway (swappable text engine; freemium quotas separate)
# Active free text: Gemini Flash (preferred) — https://aistudio.google.com/apikey
# Or Groq — https://console.groq.com/keys | OpenAI placeholder when key set
# AI_TEXT_PROVIDER=auto → gemini key → groq key → openai key → mock
AI_TEXT_PROVIDER=auto
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-2.0-flash
AI_VISION_POSE_PROVIDER=stub
AI_VISION_FOOD_PROVIDER=stub
# Free daily AI chat without Pro (0 = hard paywall unless weekly tease > 0)
AI_FREE_CHAT_DAILY_LIMIT=10
# Lifetime free solo plan generations (not monthly); Pro regenerates freely
AI_FREE_PLAN_GENERATIONS=1

# APNs — instant device push (optional; Socket.IO notification.created still works without these)
# Use a separate .p8 Key with APNs enabled, or reuse Apple IAP key if it has push capability.
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=
APNS_PRIVATE_KEY_P8=
APNS_ENVIRONMENT=sandbox

# Phase 4 — Pakistan local Boost (JazzCash / Easypaisa)
# PKR amountMinor in DB = paisa (×100). JazzCash pp_Amount = paisa; Easypaisa = rupees.00
JAZZCASH_MERCHANT_ID=
JAZZCASH_PASSWORD=
JAZZCASH_INTEGRITY_SALT=
JAZZCASH_RETURN_URL=tactech://billing/boost/success
JAZZCASH_IPN_URL=
JAZZCASH_CHECKOUT_URL=https://sandbox.jazzcash.com.pk/CustomerPortal/transactionmanagement/merchantform/

EASYPAISA_STORE_ID=
EASYPAISA_HASH_KEY=
EASYPAISA_RETURN_URL=tactech://billing/boost/success
EASYPAISA_IPN_URL=
EASYPAISA_CHECKOUT_URL=

BOOST_SUCCESS_URL=tactech://billing/boost/success?attempt_id={ATTEMPT_ID}
BOOST_CANCEL_URL=tactech://billing/boost/cancel

# Phase 7 — Coach verification admin review
ADMIN_API_KEY=change-me-admin-key
VERIFY_DOC_RETENTION_DAYS=90
VERIFY_UPLOAD_MAX_BYTES=10485760
