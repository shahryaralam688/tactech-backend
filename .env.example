APP_NAME=TacTech
APP_ENV=development
LOG_LEVEL=INFO

POSTGRES_USER=tactech
POSTGRES_PASSWORD=change_me
POSTGRES_DB=tactech

DATABASE_URL=postgresql+psycopg2://tactech:change_me@localhost:5432/tactech
REDIS_URL=redis://localhost:6379/0

JWT_SECRET=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

CORS_ORIGINS=http://localhost,http://127.0.0.1,http://localhost:8080

SEED_TRAINER_PASSWORD=trainer123
SEED_TRAINEE_PASSWORD=trainee123

PUBLIC_BASE_URL=
UPLOAD_DIR=uploads
MAX_UPLOAD_BYTES=5242880

NGROK_AUTHTOKEN=

# AI Coach (demo: free Groq — https://console.groq.com/keys)
# Later: AI_PROVIDER=openai + OPENAI_API_KEY=sk-...
AI_PROVIDER=groq
GROQ_API_KEY=
GROQ_CHAT_MODEL=llama-3.1-8b-instant
GROQ_STT_MODEL=whisper-large-v3
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_STT_MODEL=whisper-1
OPENAI_TTS_MODEL=tts-1
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
AI_TTS_PROVIDER=edge
AI_TTS_VOICE=en-US-JennyNeural
AI_MAX_CONTEXT_CHUNKS=8
AI_CHAT_TEMPERATURE=0.4
AI_CHAT_MAX_TOKENS=700
GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
OPENAI_VISION_MODEL=gpt-4o-mini
WEBRTC_STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302
